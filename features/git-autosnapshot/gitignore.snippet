
# >>> dinomem git-autosnapshot ignores >>>
# The snapshot store itself (its own object DB lives inside the work-tree) —
# MUST be ignored or every tick sees git internals as churn and self-commits.
.dinomem-snap.git/
.dinomem-snap.git
# Runtime state that churns constantly and is never useful in git history.
# Agent runtime state (auto-generated)
agents/*/agent/models.json
agents/*/agent/plugins/*/catalog.json
agents/*/agent/*.sqlite
agents/*/agent/*.sqlite-shm
agents/*/agent/*.sqlite-wal
agents/*/agent/*.sqlite-journal
# Plain sqlite DBs anywhere (e.g. chroma.sqlite3 in vector stores). Previously
# only the -shm/-wal/-journal sidecars were ignored, so the 250MB main DB leaked.
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite.tmp-*
*.sqlite.migrated
*.migrated
# Cron/gate last-run markers
scripts/.*.last_run
workspace-*/scripts/.*.last_run
# Cache/tee spill
memory/cache/
workspace-*/memory/cache/
logs/
# Vector DB / models / big runtime data (regenerable, huge).
# NOTE: neuron adds sibling stores kb/vector_db_sessions/ and kb/vector_db_docs/
# — the old `vector_db/` glob does NOT match those (different dir name, not a
# subdir). Use vector_db* to cover the whole family, present and future.
kb/vector_db*/
workspace-*/kb/vector_db*/
kb/memory_neuron/
workspace-*/kb/memory_neuron/
models/
workspace-*/models/
# Neuron code-structure graph: kb/code_graph/graph.db is a ~700MB derived,
# rebuildable index (AST/graph store) that rewrites on refresh — same churny/
# huge class as the vector DBs. The vector_db* glob does NOT match it (different
# dir), so it needs its own rule. Missing this was a real leak vector.
kb/code_graph/
workspace-*/kb/code_graph/
# Quarantined corrupt vector-DB dirs dinomem itself renames aside on a failed
# rebuild (kb/.vector_db_sessions.corrupt-<ts>/). Derived, huge, never useful.
kb/.vector_db*.corrupt-*/
workspace-*/kb/.vector_db*.corrupt-*/
# Rotated memory archive dinomem writes when it ages out daily notes.
.memory_archive/
workspace-*/.memory_archive/
# OpenClaw runtime dirs (dinomem runs inside OpenClaw, so these are always
# present + always churny/regenerable on a dinomem host): staged inbound media,
# per-run cache, and transient runtime state.
cache/
workspace-*/cache/
runtime/
workspace-*/runtime/
media/inbound/
workspace-*/media/inbound/
# git-autosnapshot's own log
logs/git-autosnapshot.log
# Generic dev-junk hygiene. WHY: the rules above only cover dinomem's OWN
# derived data (vector DBs, sqlite, models). A workspace can also accrue
# standard dev cruft — a Python venv, node_modules, __pycache__, .env secrets —
# which is huge/churny/regenerable and must never enter snapshot history.
# Without these, dropping a venv or running `npm install` in a snapshotted
# workspace would leak exactly the way the vector DBs did.
.venv/
venv/
env/
**/.venv/
**/venv/
**/site-packages/
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
**/*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
# Secrets — never snapshot credential files.
.env
*.env
**/.env
.env.local
.env.*.local
# Convention-junk on a dinomem/OpenClaw host: local backup dirs and loose *.db
# dumps. NOTE (tradeoff): these are broader than dinomem's own artifacts — if
# YOU deliberately keep a `backups/` dir or a `data/*.db` you want versioned,
# allowlist it via `.dinomem-keep-large` or remove these lines from this store's
# info/exclude. Default-ignored here because on a standard box they're
# regenerable junk, and silently bloating .git is the worse failure.
backup/
backups/
workspace-*/backup/
workspace-*/backups/
data/*.db
workspace-*/data/*.db
# <<< dinomem git-autosnapshot ignores <<<
